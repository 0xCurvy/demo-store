{
  "name": "curvy-checkout-demo",
  "version": "0.1.0",
  "private": true,
  "description": "A small shop that takes payments with Curvy checkout: an Express backend and a React frontend.",
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "dev": "pnpm --filter @curvy-checkout-demo/server dev",
    "build": "pnpm --filter @curvy-checkout-demo/web build && pnpm --filter @curvy-checkout-demo/server build",
    "start": "pnpm --filter @curvy-checkout-demo/server start",
    "create-signer": "pnpm --filter @curvy-checkout-demo/server exec curvy-payments create-signer --out ../checkout-signer.secret.json",
    "test": "pnpm --recursive test",
    "typecheck": "pnpm --recursive typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "pnpm typecheck && pnpm lint && prettier --check . && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.3.0",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "0.6.14",
    "tailwindcss": "4.1.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "6.4.3",
    "vitest": "3.2.4"
  }
}
