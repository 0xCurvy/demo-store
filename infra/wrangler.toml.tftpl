# Generated by Terraform from infra/: do not edit by hand. Run `terraform apply` in infra/ instead.
name = "brutalism-store"
main = "src/index.ts"
compatibility_date = "2026-08-15"
compatibility_flags = ["nodejs_compat"]
account_id = "${account_id}"
workers_dev = false

# The built web app is served as static assets next to the Worker; the Worker answers /api, /download
# and the signer list, and falls back to index.html for the React pages.
[assets]
directory = "../web/dist"
binding = "ASSETS"
not_found_handling = "single-page-application"
run_worker_first = ["/api/*", "/download/*", "/.well-known/*"]

[observability]
enabled = true
%{ for name, env in environments ~}

[env.${name}]
workers_dev = ${env.workers_dev}
routes = [{ pattern = "${env.host}", custom_domain = true }]

# Public settings; an empty value counts as unset. The secrets (signing key, admin token, and RPC_URL only when the
# shop uses its own endpoint instead of the gateway's /rpc proxy) are set on the Worker by the deploy workflow.
[env.${name}.vars]
ENVIRONMENT = "${name}"
MERCHANT_ORIGIN = "https://${env.host}"
CURVY_ENVIRONMENT = "${env.curvy_environment}"
CURVY_API_URL = "${env.curvy_api_url}"
CHECKOUT_URL = "${env.checkout_url}"
CURVY_PAYMENTS_PUBLIC_KEY = "${env.receiving_keys}"
CHAIN_ID = "${env.chain_id}"
AGGREGATOR_ADDRESS = "${env.aggregator_address}"
TOKENS = "${env.tokens}"
X402_RECOVERY_ADDRESS = "${env.x402_recovery}"

[[env.${name}.d1_databases]]
binding = "ORDERS"
database_name = "${env.d1_name}"
database_id = "${env.d1_id}"

[[env.${name}.r2_buckets]]
binding = "WALLPAPERS"
bucket_name = "${env.r2_name}"

# The reconciler: the background payment check the Node server ran on a timer.
[env.${name}.triggers]
crons = ["${env.cron}"]
%{ endfor ~}
