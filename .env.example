# Overprint, a Curvy checkout demo. Copy this file to .env and fill it in.
# The server starts with missing values and lists them on the shop page, so you can
# set them one at a time. It never prints the signing key or RPC_URL.

# --- From the Curvy web app's Payments setup ---

# Your public key for payments: the "01…" line in step 3 of Payments setup.
# It lets people pay you; it cannot spend or reveal your funds.
CURVY_PAYMENTS_PUBLIC_KEY=

# The network and token. Payments setup fills these in for the network you pick.
# Ethereum Sepolia (test money):
#   CHAIN_ID=11155111
#   TOKEN_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
# Arbitrum One (real money):
#   CHAIN_ID=42161
#   TOKEN_ADDRESS=0xaf88d065e77c8cC2239327C5EDb3A432268e5831
CHAIN_ID=
TOKEN_ADDRESS=
AGGREGATOR_ADDRESS=

# Curvy's checkout page, with its path.
CHECKOUT_URL=https://app.curvy.box/checkout

# Blocks to wait after the payment before an order counts as paid.
CONFIRMATIONS=12

# When an order counts as paid: "shielded" (the default: the money is safe under your
# keys) or "committed" (also wait until the money is spendable).
PAID_WHEN=shielded

# --- This shop ---

# SECRET. The key that signs your checkout requests. Create one with:
#   pnpm create-signer
# then paste the private key from checkout-signer.secret.json here and delete that file.
MERCHANT_INTENT_SIGNING_KEY=

# This shop's own origin: where buyers come back to and where Curvy checkout reads
# /.well-known/curvy-payments.json. Plain http works only for localhost.
MERCHANT_ORIGIN=http://localhost:3100

# Your RPC endpoint for CHAIN_ID. It may contain an API key; it stays on the server.
RPC_URL=

# SECRET, optional. Opens the admin page at /admin. At least 16 random characters,
# for example the output of: openssl rand -hex 16
ADMIN_TOKEN=

# --- Optional ---

# How long a checkout link stays open, in seconds (120 to 86400). Default 3600: an hour leaves
# time to pay from an exchange, which checkout offers only while 30 minutes of the link are left.
# PAYMENT_TTL_SECONDS=3600

# When Curvy checkout stops accepting the signer (ISO date). Default: 90 days after start.
# MERCHANT_SIGNER_NOT_AFTER=2027-01-01T00:00:00Z

# PORT=3100
# STORE_FILE=.data/orders.json
# CHECK_PAYMENTS_EVERY_SECONDS=30

# Behind a proxy or host (Railway, Fly.io, Cloudflare…), the header it puts the visitor's
# address in. Rate limits count per visitor address; without this, everyone behind the proxy
# shares one limit. Name only a header your host always overwrites, such as X-Real-IP on
# Railway: one visitors can set themselves would let them dodge the limits.
# CLIENT_IP_HEADER=X-Real-IP
# How many unpaid orders the shop keeps open at once. Each is checked on chain until it is
# paid or expires, so the cap keeps a flood of orders from crowding out real ones.
# MAX_OPEN_ORDERS=200
